# CLIProxyAPI v7.3.9 disposable E2E configuration.
host: "0.0.0.0"
port: 8317
auth-dir: "/root/.cli-proxy-api"
api-keys: ["@API_KEY@"]
request-retry: 0
usage-statistics-enabled: true
remote-management:
  allow-remote: true
  secret-key: "@MANAGEMENT_KEY@"
  disable-control-panel: false
plugins:
  enabled: true
  dir: "/CLIProxyAPI/plugins"
  configs:
    model-combo:
      enabled: true
      priority: 100
      retention_days: 1
      routes: []
openai-compatibility:
  - name: fake
    prefix: fake
    base-url: "http://fake-provider:19080/v1"
    api-key-entries:
      - api-key: fake-provider-key
    models:
      - name: dashboard-e2e-model-a
      - name: dashboard-e2e-model-b
