# CLIProxyAPI + Model Combo Deployment Environment
#
# Copy to .env and customize for your environment.
# Never commit .env with real credentials; use secrets management system in production.
#

# CPA Image and Version
# Default: docker.io/eceasy/cli-proxy-api:v7.3.9
# To use specific tag: CPA_IMAGE=docker.io/eceasy/cli-proxy-api:v7.3.9
CPA_IMAGE=docker.io/eceasy/cli-proxy-api:v7.3.9
CPA_IMAGE_TAG=v7.3.9

# Container naming and restart policy
CPA_CONTAINER_NAME=cpa-model-combo
# Restart policy (hardcoded in compose.yaml; shown here for reference)
# Existing: unless-stopped

# Network binding
# Default: 127.0.0.1 (localhost only, safe for development)
# Production: set to 0.0.0.0 only if behind reverse proxy; never expose directly
CPA_BIND_HOST=127.0.0.1
CPA_PORT=8317

# Configuration file (mounted read-only into /CLIProxyAPI/config.yaml)
# File must exist and contain valid CPA configuration
CPA_CONFIG_FILE=./config.yaml

# Plugin directory (mounted at /CLIProxyAPI/plugins; contains model-combo.so)
# Must contain extracted Linux shared object binary matching container architecture
# Configured image requires linux/amd64 ELF binary (verify: file model-combo.so)
CPA_PLUGIN_DIR=./plugins

# Container user/group (rootless podman)
# Default: 1000:3000
# For rootless: CPA_UID=$(id -u), CPA_GID=$(id -g)
CPA_UID=1000
CPA_GID=3000

# Resource limits
CPA_MEM_LIMIT=1g
CPA_MEMSWAP_LIMIT=1g
CPA_CPUS=2

# CPA API Key (random 32+ alphanumeric chars)
# NEVER commit real keys; inject via secrets manager or .env.local (gitignored)
# Generation: openssl rand -hex 16
CPA_API_KEY=placeholder_replace_with_real_key_32_chars_minimum

# Dashboard management key (random 48+ alphanumeric chars)
# Generation: openssl rand -base64 36 | tr -d '=+/' | cut -c1-48
CPA_MANAGEMENT_KEY=placeholder_replace_with_real_key_48_chars_minimum

# Provider configuration (customize for your provider)
CPA_PROVIDER_NAME=openai
CPA_BASE_URL=https://api.openai.com/v1
CPA_PROVIDER_API_KEY=sk-placeholder_replace_with_real_provider_key

# Model Combo Plugin
# Binary architecture must match container: linux/amd64, linux/arm64, etc.
# See PLUGIN_ARCH below to validate before deployment
PLUGIN_ARCH=linux/amd64
PLUGIN_VERSION=0.0.0-dev

# Note: cpa_plugins is a bind mount (CPA_PLUGIN_DIR), not a named volume
# cpa_plugins_volume=cpa_plugins  # unused; plugin directory is bound from host ./plugins/

# Logging
# Optional: configure CPA logging verbosity if supported
# CPA_LOG_LEVEL=info

# Feature flags
# Enable/disable non-critical features
# CPA_ENABLE_USAGE_STATS=true
# CPA_ENABLE_DASHBOARD=true
